[
  {
    "scenarioName": "Calculator: jsonPath modifications",
    "steps": [
      {
        "stepType": "CALCULATOR",
        "hostRef": "calcApi",
        "additionalData": {
          "operation": "add"
        },
        "returnCode": 200,
        "stepName": "Add 3 + 5 = 8 jsonPath style",
        "modifyRequests": [
          {
            "jsonPath": "$.a",
            "modifiedValue": "3"
          },
          {
            "jsonPath": "$.b",
            "modifiedValue": "5"
          }
        ],
        "validateResponse": [
          {
            "jsonPath": "$.result",
            "validatedParameterValue": "8",
            "validationType": "equal"
          },
          {
            "jsonPath": "$.operation",
            "validatedParameterValue": "add",
            "validationType": "include"
          }
        ]
      }
    ]
  },
