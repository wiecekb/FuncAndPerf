{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "../src/test-modules/browser/step-browser.json",
  "title": "Browser Step Definitions",
  "description": "Step-type-specific schema for BROWSER functional UI steps",
  "definitions": {
    "BrowserSelector": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "description": "Reference to selector defined in config.yaml browser.selectors, e.g. mainPage.heading"
        },
        {
          "type": "object",
          "required": ["kind", "role"],
          "properties": {
            "kind": { "const": "role" },
            "role": { "type": "string" },
            "name": { "type": "string" },
            "exact": { "type": "boolean" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "text"],
          "properties": {
            "kind": { "const": "label" },
            "text": { "type": "string" },
            "exact": { "type": "boolean" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "value"],
          "properties": {
            "kind": { "const": "testId" },
            "value": { "type": "string" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "value"],
          "properties": {
            "kind": { "const": "text" },
            "value": { "type": "string" },
            "exact": { "type": "boolean" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "value"],
          "properties": {
            "kind": { "const": "css" },
            "value": { "type": "string" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "value"],
          "properties": {
            "kind": { "const": "xpath" },
            "value": { "type": "string" }
          },
          "additionalProperties": false
        }
      ]
    },
    "BrowserInstruction": {
      "type": "object",
      "oneOf": [
        {
          "required": ["kind", "action"],
          "properties": {
            "kind": { "const": "action" },
            "action": { "type": "string", "enum": ["goto", "click", "fill", "press", "waitFor", "screenshot"] },
            "selector": { "$ref": "#/definitions/BrowserSelector" },
            "value": { "type": "string" },
            "timeoutMs": { "type": "integer" },
            "key": { "type": "string" }
          },
          "additionalProperties": false
        },
        {
          "required": ["kind", "assertion"],
          "properties": {
            "kind": { "const": "assertion" },
            "assertion": { "type": "string", "enum": ["toBeVisible", "toHaveText", "toHaveValue", "toContainText", "toHaveURL"] },
            "selector": { "$ref": "#/definitions/BrowserSelector" },
            "expected": { "type": "string" },
            "timeoutMs": { "type": "integer" }
          },
          "additionalProperties": false
        },
        {
          "required": ["kind", "extract", "saveAs"],
          "properties": {
            "kind": { "const": "extract" },
            "extract": { "type": "string", "enum": ["textContent", "inputValue", "href", "url"] },
            "selector": { "$ref": "#/definitions/BrowserSelector" },
            "saveAs": { "type": "string", "pattern": "^[a-zA-Z0-9_]+$" }
          },
          "additionalProperties": false
        }
      ]
    },
    "BrowserAdditionalData": {
      "type": "object",
      "required": ["instructions"],
      "properties": {
        "instructions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/BrowserInstruction" }
        },
        "baseUrl": { "type": "string", "description": "Legacy fallback: base URL for this step (deprecated, use hostRef + path)" },
        "screenshot": {
          "type": "object",
          "required": ["enabled"],
          "properties": {
            "enabled": { "type": "boolean" },
            "mode": {
              "type": "string",
              "enum": ["manualOnly", "onStepEnd", "onAssertionFail"]
            },
            "fullPage": { "type": "boolean" },
            "namePrefix": { "type": "string" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "BrowserStep": {
      "type": "object",
      "required": ["returnCode", "stepType", "additionalData"],
      "properties": {
        "stepName": { "type": "string" },
        "stepInstanceName": {
          "type": "string",
          "pattern": "^[a-zA-Z_][a-zA-Z0-9_-]*$",
          "description": "Optional logical instance name for this stepType. Steps with the same stepType and stepInstanceName share browser page/context state. Missing value uses the default instance."
        },
        "hostRef": {
          "type": "string",
          "description": "Reference to a host alias defined in config.yaml hosts map"
        },
        "stepType": { "const": "BROWSER" },
        "dataHandlerName": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_]+$"
        },
        "returnCode": { "type": "integer" },
        "additionalData": { "$ref": "#/definitions/BrowserAdditionalData" }
      },
      "additionalProperties": false
    }
  }
}
